{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "application",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "ressources",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/marque/**", "/icones/**", "/polices/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "referentiel",
      "urls": ["/api/referentiel"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 2, "maxAge": "30d", "timeout": "4s" }
    },
    {
      "name": "fonds-de-carte",
      "urls": ["https://*.tile.openstreetmap.org/**", "https://server.arcgisonline.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 600, "maxAge": "14d" }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"]
}
