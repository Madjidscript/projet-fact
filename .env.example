# Copie ce fichier en .env (meme dossier) et remplis les valeurs. Le fichier .env ne se commite JAMAIS.

# --- Assistant IA ---
# Ta cle OpenAI (commence par sk-). Vide : l'assistant dit qu'il n'est pas configure.
OPENAI_API_KEY=
# Nom exact du modele, recopie depuis la page « Models » de platform.openai.com.
OPENAI_MODEL=
# Budget de tokens par compte et par jour (defaut : 100000).
ASSISTANT_TOKENS_JOUR=100000
